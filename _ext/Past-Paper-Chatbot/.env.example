# ── Past-Paper Chatbot (Ask-AI RAG service) ───────────────────────────────
# Copy to .env and fill in. OA-backend reaches this service via its own
# CHATBOT_SERVICE_URL; this file configures the service itself.

# Public URL of THIS service, used to build the /page-image links returned in
# citations. Must be the externally reachable URL once deployed (NOT localhost),
# or the page-image thumbnails in Ask-AI answers will 404 for real users.
# Local dev default is http://localhost:8002.
CHATBOT_SERVICE_PUBLIC_URL=https://your-chatbot-service.example.com

# Supabase REST API (PostgREST) — Ask-AI reads the questions and reads/writes the
# ask_ai_chunks index over HTTPS, the same way the app reads practice questions,
# so no direct Postgres port is needed. Point at your self-hosted Supabase and
# use the service_role key. REQUIRED for Ask/Find text answers.
ASK_AI_SUPABASE_URL=https://your-supabase-host
ASK_AI_SUPABASE_SERVICE_KEY=your-service-role-key
# (falls back to SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY when those are set)

# Embedding model. Must match the vector() size in migration 024 (768) and is
# used for BOTH building the index and embedding queries. Default is fine.
# ASK_AI_EMBED_MODEL=BAAI/bge-base-en-v1.5

# ── LLM providers for answer generation (Ask mode) ────────────────────────
# Tried in order: xAI (paid, primary) → SambaNova (free) → OpenRouter (free).
# At least one is required for Ask mode; Find mode needs none (pure retrieval).
XAI_API_KEY=xai-your_key_here
SAMBANOVA_API_KEY=
OPENROUTER_API_KEY=

# ── Google Drive (for the /page-image endpoint that renders past-paper pages)─
# Same OAuth app/refresh token as OA-backend's Drive integration. Without
# these, Ask/Find still answer but citation thumbnails won't render.
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token

# PORT is injected by the platform (Railway/Render). Defaults to 8002 locally.
# PORT=8002
